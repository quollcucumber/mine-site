{
  "name": "mine-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run web:dev\"",
    "server": "node server/index.mjs",
    "build": "npm run web:build",
    "start": "node server/index.mjs",
    "test": "node test-vector.mjs && node bridge-test.mjs",
    "lint": "tsc --noEmit -p web/tsconfig.json",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "randomx.js": "^0.1.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
